{
  "name": "nim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' next dev -p 3000",
    "dev:fast": "NODE_OPTIONS='--no-deprecation' next dev -p 3000 --turbo",
    "dev:debug": "NODE_OPTIONS='--inspect --no-deprecation' next dev -p 3000",
    "dev:verbose": "NODE_OPTIONS='--no-deprecation' DEBUG=* next dev -p 3000",
    "build": "NODE_OPTIONS='--no-deprecation' next build",
    "export": "NODE_OPTIONS='--no-deprecation' next build && next export",
    "start": "NODE_OPTIONS='--no-deprecation' next start",
    "lint": "next lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^11.15.0",
    "next": "15.1.1",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sugar-high": "^0.9.3",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.1",
    "postcss": "^8",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5"
  }
}
